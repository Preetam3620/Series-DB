<%- include('partials/header') %>

<div class="container mt-5 text-center">
    <h1 class="display-4 p-3">Register</h1>

    <div class="row">
        <div class="col-sm-8">
            <div class="card">
                <div class="card-body">

                    <!-- Makes POST request to /register route -->
                    <form action="/register" method="POST">
                        <div class="mb-3 text-start h4">
                            <label for="name">Name</label>
                            <input type="text" class="form-control" name="username">
                        </div>
                        <div class="mb-3 text-start h4">
                            <label for="password">Password</label>
                            <input type="password" class="form-control" name="password">
                        </div>
                        <button type="submit" class="btn btn-dark btn-lg">Register</button>
                    </form>

                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card social-block">
                <div class="card-body">
                    <a class="btn w-100 btn-social btn-google" href="/auth/google" role="button">
                        <i class="fab fa-google"></i>
                        Sign Up with Google
                    </a>
                </div>
            </div>
            <br>
            <p class="lead text-start">If you tend to forget your password just sign up with google. Only your name
                from google account is needed. All of your information is safe with google.</p>
        </div>

    </div>
</div>

<%- include('partials/footer') %>
